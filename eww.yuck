(include "./widgets.yuck")

(defwindow dock
	:monitor 0
	:geometry (geometry :x "0px"
			    :y "0px"
			    :width "650px"
			    :height "80px" ; was 65px
			    :anchor "bottom center")
	:stacking "fg"
	:exclusive false
	:focusable false
	(dock))

(defwindow switcher
	:monitor 0
	:geometry (geometry :x "710px"
			    :y "40px"
			    :width "100px"
			    :height "30px"
			    :anchor "bottom right")
	:stacking "fg"
	:exclusive false
	:focusabe false
	(switcher))

(defwindow panel
	:monitor 0
	:geometry (geometry :x "0px"
			    :y "0px"
			    :width "50%"
			    :height "45px"
			    :anchor "bottom center")
	:stacking "bg"
	:exclusive false
	:focusable false
	(panel))
